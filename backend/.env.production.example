# Node
TZ=UTC
PORT=8000
HOST=0.0.0.0
NODE_ENV=production

# App
LOG_LEVEL=info
APP_KEY= # Generate using 'node ace generate:key'
APP_URL= # Your production URL (e.g., https://api.yourdomain.com)
FRONTEND_URL= # Your production URL (e.g., https://yourdomain.com)
# Session
SESSION_DRIVER=cookie

# Database (AWS RDS)
DB_HOST= # RDS Endpoint
DB_PORT=5432
DB_USER= # RDS Username
DB_PASSWORD= # RDS Password
DB_DATABASE= # RDS Database Name

# CORS
# CORS_ORIGIN=https://your-frontend.vercel.app
LIMITER_STORE=database
